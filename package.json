{
  "name": "budget-planner-root",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test:all",
    "test:engine": "vitest run --pool=threads packages/engine",
    "test:server": "npm run test --workspace=@budget/server",
    "test:web": "npm run test --workspace=@budget/web",
    "test:all": "npm run test:engine && npm run test:server && npm run test:web",
    "build": "npm run build --workspace=@budget/web",
    "build:web": "npm run build --workspace=@budget/web",
    "dev:server": "npm run dev --workspace=@budget/server",
    "dev:web": "npm run dev --workspace=@budget/web",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "kill:server": "powershell -Command \"Get-NetTCPConnection -LocalPort 4000 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }\"",
    "mobile:reverse": "\"C:\\Other_Files\\Android_sdk_tools\\platform-tools\\adb.exe\" reverse tcp:4000 tcp:4000",
    "mobile:devices": "\"C:\\Other_Files\\flutter\\bin\\flutter.bat\" devices",
    "mobile:test": "\"C:\\Other_Files\\flutter\\bin\\flutter.bat\" test apps/mobile/test",
    "mobile:run": "cd apps/mobile && \"C:\\Other_Files\\flutter\\bin\\flutter.bat\" run",
    "mobile:build-apk": "cd apps/mobile && \"C:\\Other_Files\\flutter\\bin\\flutter.bat\" build apk --debug --target-platform android-arm64"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4"
  }
}
