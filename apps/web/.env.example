# ==============================================================================
# Budget Planner - Web Client Environment Variables
# ==============================================================================

# Vite Dev Server Port
VITE_PORT=3000

# Backend API Proxy Target (used by Vite dev server to proxy /api requests)
VITE_PROXY_TARGET=http://localhost:4000

# Direct Backend API Base URL (leave empty to use relative /api with Vite dev proxy)
# Example for production build: https://api.yourbudgetplanner.com
VITE_API_URL=
