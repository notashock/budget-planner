# ==============================================================================
# Budget Planner - Server Environment Variables
# ==============================================================================

# Server HTTP Port
PORT=4000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/budget_planner

# Session Secret (random 32+ character string used to encrypt session cookies)
SESSION_SECRET=dev_session_secret_change_in_production

# Session Lifetime in Days (default: 14)
SESSION_MAX_AGE_DAYS=14

# Allowed CORS Origin(s) for client requests
# Examples: 'http://localhost:3000' or 'http://localhost:3000,http://localhost:5173' or '*'
CORS_ORIGIN=http://localhost:3000

# Optional: Google Gemini API Key for AI Assistant features (parse text & explain timeline)
# Leave empty if not using AI features
GEMINI_API_KEY=
