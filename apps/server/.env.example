# ==============================================================================
# Budget Planner - Server Environment Variables
# ==============================================================================

# Server HTTP Port
PORT=4000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# PostgreSQL connection string (Supabase or local Postgres)
DATABASE_URL=postgresql://postgres:postgrespassword@127.0.0.1:5432/budget_planner

# Secret for signing login tokens (random 32+ characters). Required in production;
# SESSION_SECRET is still read as a fallback name. In development a random one is
# generated and kept in apps/server/.jwt-dev-secret.
JWT_SECRET=

# Login lifetime in days (default: 14)
SESSION_MAX_AGE_DAYS=14

# Allowed CORS Origin(s) for client requests
# Examples: 'http://localhost:3000' or 'http://localhost:3000,http://localhost:5173'
# '*' is refused in production because login cookies are sent with requests.
CORS_ORIGIN=http://localhost:3000

# Optional: Google Gemini API Key for AI Assistant features (parse text & explain timeline)
# Leave empty if not using AI features
GEMINI_API_KEY=
